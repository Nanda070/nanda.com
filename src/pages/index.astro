---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Featured from '../components/Featured.astro';
import GithubRepos from '../components/GithubRepos.astro';
import Presence from '../components/Presence.astro';
import Footer from '../components/Footer.astro';
import { site, repoOverrides, githubDisplayLimit } from '../data/site';
import { getDisplayRepos } from '../lib/github';

const { repos, total } = await getDisplayRepos({
  username: site.githubUser,
  overrides: repoOverrides,
  limit: githubDisplayLimit,
});
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <About />
    <Featured />
    <GithubRepos repos={repos} total={total} githubUser={site.githubUser} />
    <Presence />
  </main>
  <Footer />
</Layout>
