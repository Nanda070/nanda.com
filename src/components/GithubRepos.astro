---
import type { DisplayRepo } from '../lib/github';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  repos: DisplayRepo[];
  total: number;
  githubUser: string;
}

const { locale, repos, total, githubUser } = Astro.props;
---

<section id="github" class="scroll-mt-24 px-4 py-16 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-medium tracking-wide text-white/55">{t(locale, 'githubEyebrow')}</p>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-fg sm:text-4xl">
          {t(locale, 'githubTitle')}
        </h2>
        <p class="mt-3 max-w-xl text-muted">{t(locale, 'githubLead')}</p>
      </div>
      <a
        href={`https://github.com/${githubUser}?tab=repositories`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost shrink-0 !border-border !bg-transparent !text-fg hover:!bg-white/5 sm:mr-4"
      >
        {t(locale, 'githubAll')}
      </a>
    </div>

    {
      repos.length === 0 ? (
        <p class="mt-10 text-muted">{t(locale, 'githubEmpty')}</p>
      ) : (
        <ul class="mt-10 divide-y divide-border border-y border-border">
          {repos.map((repo) => (
            <li class="row-hover">
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-col gap-2 px-1 py-5 sm:flex-row sm:items-start sm:justify-between sm:px-2"
              >
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-display text-lg font-semibold text-fg">{repo.name}</h3>
                    {repo.archived && (
                      <span class="text-xs text-muted uppercase">{t(locale, 'githubArchived')}</span>
                    )}
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{repo.description}</p>
                </div>
                <div class="flex shrink-0 gap-4 pt-0.5 text-xs text-muted">
                  {repo.language && <span>{repo.language}</span>}
                  {repo.stars > 0 && <span>★ {repo.stars}</span>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      total > repos.length && (
        <p class="mt-5 text-sm text-muted">
          {t(locale, 'githubShown', { shown: repos.length, total })}
        </p>
      )
    }
  </div>
</section>
