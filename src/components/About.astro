---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const nullsecLogo = `${base}${site.nullsec.logo}`;
---

<section id="about" class="scroll-mt-24 px-4 py-16 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-medium tracking-wide text-white/55">Обо мне</p>
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight text-fg sm:text-4xl">
      {site.headline}
    </h2>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{site.about}</p>
    <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-strong">
      <span>{site.facts.join(' · ')}</span>
      <span class="text-border" aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1.5 text-muted">
        <img
          src={nullsecLogo}
          alt=""
          width="14"
          height="14"
          class="h-3.5 w-3.5 opacity-70"
        />
        {site.nullsec.label}
      </span>
    </p>
  </div>
</section>
