---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<header class="absolute inset-x-0 top-0 z-40">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5 sm:px-6"
    aria-label="Основная навигация"
  >
    <a
      href={`${base}#`}
      class="font-display text-base font-bold tracking-tight text-white transition-opacity hover:opacity-90"
    >
      {site.name}
    </a>
    <ul class="flex items-center gap-1 text-sm sm:gap-2">
      <li>
        <a
          href={`${base}#about`}
          class="link-soft rounded-[10px] px-3 py-2">Обо мне</a
        >
      </li>
      <li>
        <a
          href={`${base}#projects`}
          class="link-soft rounded-[10px] px-3 py-2">Проекты</a
        >
      </li>
      <li>
        <a href={`${base}#links`} class="link-soft rounded-[10px] px-3 py-2">Связь</a>
      </li>
    </ul>
  </nav>
</header>
