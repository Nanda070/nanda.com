---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="hero-plane relative overflow-hidden text-white">
  <div
    class="relative mx-auto flex min-h-[min(82vh,760px)] w-full max-w-6xl flex-col justify-center px-4 pb-10 pt-28 sm:px-6 sm:pt-32"
  >
    <p class="anim-in text-sm font-medium tracking-[0.08em] text-white/65 uppercase">
      {site.headline}
    </p>

    <h1
      class="anim-in-d1 mt-4 font-display text-[clamp(3.5rem,11vw,6rem)] leading-[0.92] font-extrabold tracking-tight text-white"
    >
      {site.name}
    </h1>

    <p class="anim-in-d1 mt-6 max-w-xl text-lg leading-relaxed text-white/80 sm:text-xl">
      {site.tagline}
    </p>

    <div class="anim-in-d2 mt-9 flex flex-wrap items-center gap-3">
      <a href={`${base}#projects`} class="btn-primary">Проекты</a>
      <a href={`${base}#links`} class="btn-ghost">Связь</a>
      <a
        href="https://t.me/nanda070"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost">Telegram</a
      >
    </div>
  </div>

  <div class="relative" aria-hidden="true">
    <svg
      viewBox="0 0 1440 96"
      preserveAspectRatio="none"
      class="block h-12 w-full sm:h-16 md:h-20"
    >
      <path
        fill="#0B0E14"
        d="M0,64 C240,96 480,16 720,40 C960,64 1200,96 1440,48 L1440,96 L0,96 Z"></path>
    </svg>
  </div>
</section>
