---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<section class="hero-plane relative overflow-hidden text-white">
  <div
    class="relative mx-auto flex min-h-[min(78vh,720px)] w-full max-w-6xl flex-col justify-center px-4 pb-8 pt-24 sm:px-6 sm:pt-28"
  >
    <p class="anim-in text-sm font-medium tracking-wide text-white/70">{site.headline}</p>

    <h1
      class="anim-in-d1 mt-3 font-display text-[clamp(3.25rem,10vw,5.5rem)] leading-[0.95] font-extrabold tracking-tight text-white/95"
    >
      {site.name}
    </h1>

    <p class="anim-in-d1 mt-5 max-w-lg text-base leading-relaxed text-white/80 sm:text-lg">
      {site.tagline}
    </p>

    <div class="anim-in-d2 mt-8 flex flex-wrap items-center gap-3">
      <a href={`${base}#projects`} class="btn-primary">Проекты</a>
      <a
        href="https://t.me/nanda070"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost">Telegram</a
      >
      <a
        href="https://discord.gg/cheterin"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost">Discord</a
      >
    </div>
  </div>

  <div class="relative" aria-hidden="true">
    <svg
      viewBox="0 0 1440 96"
      preserveAspectRatio="none"
      class="block h-12 w-full sm:h-16 md:h-20"
    >
      <path
        fill="#0B0E14"
        d="M0,64 C240,96 480,16 720,40 C960,64 1200,96 1440,48 L1440,96 L0,96 Z"></path>
    </svg>
  </div>
</section>
