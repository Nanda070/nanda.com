---
interface Props {
  label: string;
  handle: string;
  value: string;
}

const { label, handle, value } = Astro.props;
---

<button
  type="button"
  class="copy-btn flex w-full cursor-pointer items-baseline justify-between gap-4 border-0 bg-transparent p-0 text-left"
  data-copy={value}
  aria-label={`Скопировать ${label}: ${handle}`}
>
  <span class="text-sm text-muted">{label}</span>
  <span class="flex items-center gap-2 font-medium text-fg">
    <span class="copy-handle">{handle}</span>
    <span class="copy-hint text-xs text-accent opacity-0 transition-opacity" aria-live="polite"
      >скопировано</span
    >
  </span>
</button>

<script>
  function bindCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = value;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        const hint = btn.querySelector('.copy-hint');
        if (hint) {
          hint.classList.add('!opacity-100');
          window.setTimeout(() => hint.classList.remove('!opacity-100'), 1600);
        }
      });
    });
  }

  bindCopyButtons();
  document.addEventListener('astro:page-load', bindCopyButtons);
</script>
