---
import { links } from '../data/site';
import BrandIcon from './BrandIcon.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const iconFor: Record<string, string> = {
  email: 'mail',
  phone: 'phone',
  telegram: 'telegram',
  'discord-server': 'discord',
  'discord-user': 'discord',
  github: 'github',
  spotify: 'spotify',
  steam: 'steam',
  riot: 'riot',
};

const groups: { key: 'contact' | 'social' | 'games'; titleKey: 'groupContact' | 'groupSocial' | 'groupGames' }[] =
  [
    { key: 'contact', titleKey: 'groupContact' },
    { key: 'social', titleKey: 'groupSocial' },
    { key: 'games', titleKey: 'groupGames' },
  ];
---

<section id="links" class="scroll-mt-24 px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="text-sm font-medium tracking-wide text-white/55">{t(locale, 'linksEyebrow')}</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-fg sm:text-4xl">
        {t(locale, 'linksTitle')}
      </h2>
      <p class="mt-3 text-muted">{t(locale, 'linksLead')}</p>
    </div>

    <div class="mt-12 space-y-10">
      {
        groups.map(({ key, titleKey }) => {
          const items = links.filter((l) => l.group === key);
          return (
            <div>
              <h3 class="mb-4 text-sm font-medium text-white/45">{t(locale, titleKey)}</h3>
              <ul class="grid gap-3 sm:grid-cols-2">
                {items.map((item) => (
                  <li>
                    {item.href ? (
                      <a
                        href={item.href}
                        target={item.href.startsWith('http') ? '_blank' : undefined}
                        rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class="link-tile group"
                      >
                        <span class="link-tile-icon">
                          <BrandIcon name={iconFor[item.id] ?? 'mail'} />
                        </span>
                        <span class="min-w-0 flex-1">
                          <span class="block text-sm font-semibold text-fg">{item.label[locale]}</span>
                          <span class="mt-0.5 block truncate text-sm text-muted">{item.handle}</span>
                        </span>
                        <span class="link-tile-arrow" aria-hidden="true">
                          {item.href.startsWith('http') ? '↗' : '→'}
                        </span>
                      </a>
                    ) : (
                      <button
                        type="button"
                        class="link-tile group copy-btn w-full text-left"
                        data-copy={item.copyValue}
                      >
                        <span class="link-tile-icon">
                          <BrandIcon name={iconFor[item.id] ?? 'discord'} />
                        </span>
                        <span class="min-w-0 flex-1">
                          <span class="block text-sm font-semibold text-fg">{item.label[locale]}</span>
                          <span class="mt-0.5 block truncate text-sm text-muted">
                            <span class="copy-handle">{item.handle}</span>
                            <span class="copy-hint ml-2 text-accent opacity-0 transition-opacity">
                              {t(locale, 'copied')}
                            </span>
                          </span>
                        </span>
                        <span class="text-xs text-white/35 group-hover:text-white/60">
                          {t(locale, 'copy')}
                        </span>
                      </button>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  function bindCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = value;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        const hint = btn.querySelector('.copy-hint');
        if (hint) {
          hint.classList.add('!opacity-100');
          window.setTimeout(() => hint.classList.remove('!opacity-100'), 1600);
        }
      });
    });
  }

  bindCopyButtons();
  document.addEventListener('astro:page-load', bindCopyButtons);
</script>
